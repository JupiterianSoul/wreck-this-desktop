#!/bin/sh
here=$(dirname "$(readlink -f "$0")")
unset __NV_PRIME_RENDER_OFFLOAD __VK_LAYER_NV_optimus
export __GLX_VENDOR_LIBRARY_NAME=mesa
[ -f /usr/share/glvnd/egl_vendor.d/50_mesa.json ] && export __EGL_VENDOR_LIBRARY_FILENAMES=/usr/share/glvnd/egl_vendor.d/50_mesa.json
[ -f /usr/share/vulkan/icd.d/radeon_icd.json ] && export VK_DRIVER_FILES=/usr/share/vulkan/icd.d/radeon_icd.json
export LIBVA_DRIVER_NAME=radeonsi
export GSK_RENDERER="${GSK_RENDERER:-gl}"
case "$1" in
  panic|restore|status|watchdog) exec python3 "$here/host/wtd.py" "$@" ;;
esac
if [ -z "$WTD_TEST" ] && [ -f /usr/lib/libgtk4-layer-shell.so ]; then
  export LD_PRELOAD="/usr/lib/libgtk4-layer-shell.so${LD_PRELOAD:+:$LD_PRELOAD}"
fi
exec python3 "$here/host/wtd.py" "$@"
